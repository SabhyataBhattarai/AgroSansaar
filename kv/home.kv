<HomeScreen>:

    ScrollView:
        do_scroll_x: False
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: "20dp", "18dp", "20dp", "18dp"
            spacing: "20dp"
            md_bg_color: 0.965, 0.973, 0.949, 1

            ####################################################
            ## HEADER (Logo badge + Brand + Language pill)
            ####################################################

            BoxLayout:
                size_hint_y: None
                height: "56dp"
                spacing: "12dp"

                MDCard:
                    size_hint: None, None
                    size: "48dp", "48dp"
                    radius: [24]
                    elevation: 0
                    md_bg_color: 0.114, 0.404, 0.216, 1
                    pos_hint: {"center_y": .5}

                    AnchorLayout:
                        MDIcon:
                            icon: "sprout"
                            font_size: "26sp"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                BoxLayout:
                    orientation: "vertical"
                    spacing: "1dp"

                    MDLabel:
                        text: "AgroSansar"
                        size_hint_y: None
                        height: "28dp"
                        bold: True
                        font_size: "24sp"
                        theme_text_color: "Custom"
                        text_color: 0.114, 0.404, 0.216, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    MDLabel:
                        id: tagline
                        text: "तपाईंको कृषि सहयोगी"
                        font_name: "NepaliFont"
                        size_hint_y: None
                        height: "22dp"
                        font_size: "14sp"
                        theme_text_color: "Custom"
                        text_color: 0.42, 0.45, 0.42, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                MDRaisedButton:
                    id: language_button
                    text: "EN"
                    font_name: "NepaliFont"
                    md_bg_color: 0.867, 0.929, 0.847, 1
                    text_color: 0.114, 0.404, 0.216, 1
                    elevation: 0
                    size_hint: None, None
                    size: "58dp", "40dp"
                    pos_hint: {"center_y": .5}

                    on_release:
                        root.toggle_language()

            Widget:
                size_hint_y: None
                height: "6dp"

            ####################################################
            ## PRIMARY FEATURE (Voice Assistant) — hero card
            ####################################################

            MDCard:
                size_hint_y: None
                height: "176dp"
                radius: [26]
                elevation: 2
                ripple_behavior: True
                padding: "20dp"
                md_bg_color: 1, 1, 1, 1

                on_release:
                    root.open_assistant()

                BoxLayout:
                    spacing: "16dp"

                    MDCard:
                        size_hint: None, None
                        size: "72dp", "72dp"
                        radius: [36]
                        elevation: 0
                        md_bg_color: 0.867, 0.929, 0.847, 1
                        pos_hint: {"center_y": .5}

                        AnchorLayout:
                            MDIcon:
                                icon: "microphone"
                                font_size: "38sp"
                                theme_text_color: "Custom"
                                text_color: 0.114, 0.404, 0.216, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"
                        pos_hint: {"center_y": .5}

                        MDLabel:
                            id: assistant_title
                            text: "Voice Agricultural Assistant"
                            font_name: "NepaliFont"
                            bold: True
                            font_size: "18sp"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.114, 0.404, 0.216, 1
                            text_size: self.width, None
                            adaptive_height: True

                        MDLabel:
                            id: assistant_subtitle
                            text: "कृषि सम्बन्धी प्रश्न सोध्नुहोस्"
                            font_name: "NepaliFont"
                            font_size: "14sp"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.42, 0.45, 0.42, 1
                            text_size: self.width, None
                            adaptive_height: True

                        MDLabel:
                            text: "बोल्नुहोस् र उत्तर पाउनुहोस्  ›"
                            font_name: "NepaliFont"
                            font_size: "12sp"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.290, 0.596, 0.353, 1
                            text_size: self.width, None
                            adaptive_height: True

            ####################################################
            ## FEATURE GRID
            ####################################################

            GridLayout:
                cols: 2
                spacing: "14dp"
                size_hint_y: None
                height: "192dp"

                MDCard:
                    radius: [22]
                    elevation: 2
                    ripple_behavior: True
                    padding: "16dp"
                    md_bg_color: 1, 1, 1, 1

                    on_release:
                        root.open_disease()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDCard:
                            size_hint: None, None
                            size: "52dp", "52dp"
                            radius: [16]
                            elevation: 0
                            md_bg_color: 0.867, 0.929, 0.847, 1

                            AnchorLayout:
                                MDIcon:
                                    icon: "leaf"
                                    font_size: "28sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.114, 0.404, 0.216, 1

                        MDLabel:
                            id: disease_title
                            text: "Disease Detection"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            bold: True
                            font_size: "16sp"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.145, 0.161, 0.145, 1

                        MDLabel:
                            id: disease_subtitle
                            text: "बालीको समस्या पहिचान गर्नुहोस्"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            halign: "left"
                            text_size: self.width, None
                            theme_text_color: "Custom"
                            text_color: 0.42, 0.45, 0.42, 1
                            font_size: "12.5sp"

                MDCard:
                    radius: [22]
                    elevation: 2
                    ripple_behavior: True
                    padding: "16dp"
                    md_bg_color: 1, 1, 1, 1

                    on_release:
                        root.open_weather()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDCard:
                            size_hint: None, None
                            size: "52dp", "52dp"
                            radius: [16]
                            elevation: 0
                            md_bg_color: 0.867, 0.929, 0.847, 1

                            AnchorLayout:
                                MDIcon:
                                    icon: "weather-partly-cloudy"
                                    font_size: "28sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.114, 0.404, 0.216, 1

                        MDLabel:
                            id: weather_title
                            text: "Weather"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            bold: True
                            font_size: "16sp"
                            halign: "left"
                            theme_text_color: "Custom"
                            text_color: 0.145, 0.161, 0.145, 1

                        MDLabel:
                            id: weather_subtitle
                            text: "मौसम सम्बन्धी जानकारी"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            halign: "left"
                            text_size: self.width, None
                            theme_text_color: "Custom"
                            text_color: 0.42, 0.45, 0.42, 1
                            font_size: "12.5sp"

            ####################################################
            ## ABOUT (slim shortcut row)
            ####################################################

            MDCard:
                size_hint_y: None
                height: "76dp"
                radius: [20]
                elevation: 1
                ripple_behavior: True
                padding: "14dp"
                md_bg_color: 1, 1, 1, 1

                on_release:
                    root.open_about()

                BoxLayout:
                    spacing: "12dp"

                    MDCard:
                        size_hint: None, None
                        size: "44dp", "44dp"
                        radius: [14]
                        elevation: 0
                        md_bg_color: 0.965, 0.937, 0.902, 1
                        pos_hint: {"center_y": .5}

                        AnchorLayout:
                            MDIcon:
                                icon: "information-outline"
                                font_size: "24sp"
                                theme_text_color: "Custom"
                                text_color: 0.804, 0.522, 0.247, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "2dp"
                        pos_hint: {"center_y": .5}

                        MDLabel:
                            id: about_title
                            text: "AgroSansar के हो?"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            bold: True
                            font_size: "15sp"
                            theme_text_color: "Custom"
                            text_color: 0.145, 0.161, 0.145, 1

                        MDLabel:
                            id: about_subtitle
                            text: "एपबारे थप जानकारी"
                            font_name: "NepaliFont"
                            adaptive_height: True
                            theme_text_color: "Custom"
                            text_color: 0.42, 0.45, 0.42, 1
                            font_size: "13sp"

                    MDIcon:
                        icon: "chevron-right"
                        font_size: "22sp"
                        size_hint_x: None
                        width: "24dp"
                        theme_text_color: "Custom"
                        text_color: 0.7, 0.72, 0.7, 1
                        pos_hint: {"center_y": .5}

            ####################################################
            ## TIP OF THE DAY (fills space, adds a touch of value)
            ####################################################

            MDCard:
                size_hint_y: None
                height: "118dp"
                radius: [20]
                elevation: 0
                padding: "16dp"
                md_bg_color: 0.965, 0.937, 0.902, 1

                BoxLayout:
                    spacing: "12dp"

                    MDCard:
                        size_hint: None, None
                        size: "40dp", "40dp"
                        radius: [12]
                        elevation: 0
                        md_bg_color: 1, 1, 1, 0.6
                        pos_hint: {"top": 1}

                        AnchorLayout:
                            MDIcon:
                                icon: "lightbulb-on-outline"
                                font_size: "22sp"
                                theme_text_color: "Custom"
                                text_color: 0.804, 0.522, 0.247, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        MDLabel:
                            id: tip_title
                            text: "आजको सुझाव"
                            font_name: "NepaliFont"
                            bold: True
                            font_size: "14sp"
                            size_hint_y: None
                            height: "20dp"
                            theme_text_color: "Custom"
                            text_color: 0.6, 0.42, 0.24, 1

                        MDLabel:
                            id: tip_label
                            text: "स्वस्थ बालीका लागि हरेक हप्ता माटोको आर्द्रता जाँच गर्नुहोस् र आवश्यकता अनुसार मात्र पानी दिनुहोस्।"
                            font_name: "NepaliFont"
                            font_size: "13sp"
                            text_size: self.width, None
                            theme_text_color: "Custom"
                            text_color: 0.42, 0.32, 0.22, 1

            Widget:
                size_hint_y: None
                height: "6dp"
