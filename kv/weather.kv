#:import dp kivy.metrics.dp

<WeatherScreen>:

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.965, 0.973, 0.949, 1
        padding: "16dp"
        spacing: "12dp"

        ####################################################
        ## HEADER
        ####################################################

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "6dp"

            MDIconButton:
                icon: "arrow-left"
                theme_text_color: "Custom"
                text_color: 0.114, 0.404, 0.216, 1
                on_release:
                    root.manager.current = "home"

            BoxLayout:
                orientation: "vertical"

                MDLabel:
                    id: page_title
                    text: "मौसम जानकारी"
                    font_name: "NepaliFont"
                    bold: True
                    font_size: "19sp"
                    halign: "left"
                    theme_text_color: "Custom"
                    text_color: 0.114, 0.404, 0.216, 1

                MDLabel:
                    id: tagline
                    text: "तपाईंको कृषि सहयोगी"
                    font_name: "NepaliFont"
                    font_size: "12.5sp"
                    halign: "left"
                    theme_text_color: "Custom"
                    text_color: 0.42, 0.45, 0.42, 1

            MDRaisedButton:
                id: language_button
                text: "EN"
                font_name: "NepaliFont"
                md_bg_color: 0.867, 0.929, 0.847, 1
                text_color: 0.114, 0.404, 0.216, 1
                elevation: 0
                size_hint: None, None
                size: "58dp", "40dp"
                on_release:
                    root.toggle_language()

        ####################################################
        ## CITY DROPDOWN + LOCATE ME BUTTON
        ####################################################

        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            Widget:
                size_hint_x: 0.5

            MDCard:
                id: city_pill
                size_hint: None, None
                size: "170dp", "42dp"
                radius: [21]
                elevation: 1
                md_bg_color: 1, 1, 1, 1
                padding: "4dp"
                ripple_behavior: True
                pos_hint: {"center_y": .5}
                on_release: root.open_city_menu()

                BoxLayout:
                    spacing: "6dp"
                    padding: "10dp", "0dp"

                    MDIcon:
                        icon: "map-marker"
                        font_size: "18sp"
                        size_hint_x: None
                        width: "20dp"
                        theme_text_color: "Custom"
                        text_color: 0.114, 0.404, 0.216, 1
                        pos_hint: {"center_y": .5}

                    MDLabel:
                        id: city_spinner
                        text: "Kathmandu"
                        font_name: "NepaliFont"
                        bold: True
                        font_size: "14sp"
                        theme_text_color: "Custom"
                        text_color: 0.145, 0.161, 0.145, 1
                        pos_hint: {"center_y": .5}

                    MDIcon:
                        icon: "chevron-down"
                        font_size: "18sp"
                        size_hint_x: None
                        width: "20dp"
                        theme_text_color: "Custom"
                        text_color: 0.6, 0.62, 0.6, 1
                        pos_hint: {"center_y": .5}

            MDCard:
                size_hint: None, None
                size: "42dp", "42dp"
                radius: [21]
                elevation: 1
                md_bg_color: 0.867, 0.929, 0.847, 1
                ripple_behavior: True
                pos_hint: {"center_y": .5}
                on_release: root.use_live_location()

                AnchorLayout:
                    MDIcon:
                        icon: "crosshairs-gps"
                        font_size: "20sp"
                        theme_text_color: "Custom"
                        text_color: 0.114, 0.404, 0.216, 1

            Widget:
                size_hint_x: 0.5

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "14dp"
                padding: "2dp"

                WeatherCardHero:
                    id: day1

                WeatherCardStandard:
                    id: day2

                WeatherCardStandard:
                    id: day3

                Widget:
                    size_hint_y: None
                    height: "20dp"


####################################################
## HERO CARD TEMPLATE
####################################################

<WeatherCardHero@MDCard>
    orientation: "vertical"
    adaptive_height: True
    radius: [24]
    elevation: 3
    padding: "22dp"
    spacing: "10dp"
    md_bg_color: 1, 1, 1, 1

    MDLabel:
        id: title
        text: "आज"
        font_name: "NepaliFont"
        font_size: "19sp"
        bold: True
        halign: "center"
        text_size: self.width, None
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.114, 0.404, 0.216, 1

    AsyncImage:
        id: icon
        source: ""
        size_hint: None, None
        size: "92dp", "92dp"
        pos_hint: {"center_x": .5}

    MDLabel:
        id: temp
        text: "-- °C"
        halign: "center"
        text_size: self.width, None
        bold: True
        font_size: "38sp"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.145, 0.161, 0.145, 1

    MDLabel:
        id: condition
        text: "-"
        font_name: "NepaliFont"
        halign: "center"
        text_size: self.width, None
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.42, 0.45, 0.42, 1
        font_size: "15sp"

    MDSeparator:
        color: 0.9, 0.92, 0.89, 1

    BoxLayout:
        size_hint_y: None
        height: "26dp"

        MDLabel:
            id: humidity
            text: ""
            font_name: "NepaliFont"
            halign: "left"
            text_size: self.width, None
            theme_text_color: "Custom"
            text_color: 0.29, 0.32, 0.29, 1
            font_size: "13sp"

        MDLabel:
            id: wind
            text: ""
            font_name: "NepaliFont"
            halign: "right"
            text_size: self.width, None
            theme_text_color: "Custom"
            text_color: 0.29, 0.32, 0.29, 1
            font_size: "13sp"


####################################################
## STANDARD CARD TEMPLATE
####################################################

<WeatherCardStandard@MDCard>
    orientation: "vertical"
    adaptive_height: True
    radius: [20]
    elevation: 1
    padding: "18dp"
    spacing: "8dp"
    md_bg_color: 1, 1, 1, 1

    MDLabel:
        id: title
        text: "-"
        font_name: "NepaliFont"
        font_size: "16sp"
        bold: True
        halign: "center"
        text_size: self.width, None
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.145, 0.161, 0.145, 1

    AsyncImage:
        id: icon
        source: ""
        size_hint: None, None
        size: "64dp", "64dp"
        pos_hint: {"center_x": .5}

    MDLabel:
        id: temp
        text: "-- °C"
        halign: "center"
        text_size: self.width, None
        bold: True
        font_size: "24sp"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.145, 0.161, 0.145, 1

    MDLabel:
        id: condition
        text: "-"
        font_name: "NepaliFont"
        halign: "center"
        text_size: self.width, None
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 0.42, 0.45, 0.42, 1
        font_size: "13sp"

    MDSeparator:
        color: 0.9, 0.92, 0.89, 1

    BoxLayout:
        size_hint_y: None
        height: "24dp"

        MDLabel:
            id: humidity
            text: ""
            font_name: "NepaliFont"
            halign: "left"
            text_size: self.width, None
            theme_text_color: "Custom"
            text_color: 0.29, 0.32, 0.29, 1
            font_size: "12.5sp"

        MDLabel:
            id: wind
            text: ""
            font_name: "NepaliFont"
            halign: "right"
            text_size: self.width, None
            theme_text_color: "Custom"
            text_color: 0.29, 0.32, 0.29, 1
            font_size: "12.5sp"