<AssistantScreen>:

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.965, 0.973, 0.949, 1
        padding: "16dp"
        spacing: "14dp"

        ####################################################
        ## HEADER
        ####################################################

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "6dp"

            MDIconButton:
                icon: "arrow-left"
                theme_text_color: "Custom"
                text_color: 0.114, 0.404, 0.216, 1
                on_release:
                    root.manager.current = "home"

            BoxLayout:
                orientation: "vertical"

                MDLabel:
                    id: page_title
                    text: "कृषि सहायक"
                    font_name: "NepaliFont"
                    bold: True
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: 0.114, 0.404, 0.216, 1
                    halign: "left"

                MDLabel:
                    id: tagline
                    text: "तपाईंको कृषि सहयोगी"
                    font_name: "NepaliFont"
                    font_size: "13sp"
                    theme_text_color: "Custom"
                    text_color: 0.42, 0.45, 0.42, 1
                    halign: "left"

            MDRaisedButton:
                id: language_button
                text: "EN"
                font_name: "NepaliFont"
                md_bg_color: 0.867, 0.929, 0.847, 1
                text_color: 0.114, 0.404, 0.216, 1
                elevation: 0
                size_hint: None, None
                size: "58dp", "40dp"
                on_release:
                    root.toggle_language()

        ####################################################
        ## RECOGNIZED QUESTION
        ####################################################

        MDCard:
            size_hint_y: None
            height: "50dp"
            radius: [16]
            elevation: 1
            padding: "14dp", "6dp"
            md_bg_color: 1, 1, 1, 1

            BoxLayout:
                spacing: "10dp"

                MDIcon:
                    icon: "comment-question-outline"
                    font_size: "20sp"
                    size_hint_x: None
                    width: "22dp"
                    theme_text_color: "Custom"
                    text_color: 0.114, 0.404, 0.216, 1
                    pos_hint: {"center_y": .5}

                MDLabel:
                    id: question_label
                    text: "तपाईंले सोध्नुभएको प्रश्न यहाँ देखिनेछ।"
                    font_name: "NepaliFont"
                    font_size: "13.5sp"
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    shorten: True
                    shorten_from: "right"
                    theme_text_color: "Custom"
                    text_color: 0.42, 0.45, 0.42, 1
                    pos_hint: {"center_y": .5}

        ####################################################
        ## ANSWER CARD
        ####################################################

        MDCard:
            size_hint_y: .40
            radius: [24]
            elevation: 2
            padding: "20dp"
            md_bg_color: 1, 1, 1, 1

            MDBoxLayout:
                orientation: "vertical"
                spacing: "8dp"

                MDCard:
                    size_hint: None, None
                    size: "56dp", "56dp"
                    radius: [28]
                    elevation: 0
                    md_bg_color: 0.867, 0.929, 0.847, 1
                    pos_hint: {"center_x": .5}

                    AnchorLayout:
                        MDIcon:
                            icon: "robot-happy-outline"
                            font_size: "30sp"
                            theme_text_color: "Custom"
                            text_color: 0.114, 0.404, 0.216, 1

                MDLabel:
                    id: answer_title
                    text: "उत्तर"
                    font_name: "NepaliFont"
                    bold: True
                    font_size: "18sp"
                    halign: "center"
                    size_hint_y: None
                    height: "26dp"
                    theme_text_color: "Custom"
                    text_color: 0.145, 0.161, 0.145, 1

                MDSeparator:
                    color: 0.9, 0.92, 0.89, 1

                ScrollView:
                    do_scroll_x: False

                    MDLabel:
                        id: answer_label
                        text: "तपाईंको उत्तर यहाँ देखिनेछ।"
                        font_name: "NepaliFont"
                        font_size: "16sp"
                        halign: "center"
                        valign: "top"
                        text_size: self.width, None
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 0.42, 0.45, 0.42, 1

        ####################################################
        ## VOICE ACTION CARD (Microphone click-to-speak)
        ####################################################

        MDCard:
            size_hint_y: .30
            radius: [26]
            elevation: 2
            ripple_behavior: True
            md_bg_color: 1, 1, 1, 1
            padding: "16dp"
            on_release:
                root.listen()

            MDBoxLayout:
                orientation: "vertical"
                spacing: "6dp"

                AnchorLayout:
                    size_hint_y: None
                    height: "78dp"

                    MDCard:
                        size_hint: None, None
                        size: "78dp", "78dp"
                        radius: [39]
                        elevation: 0
                        md_bg_color: 0.867, 0.929, 0.847, 1

                        AnchorLayout:
                            MDIcon:
                                id: mic_icon
                                icon: "microphone"
                                font_size: "42sp"
                                theme_text_color: "Custom"
                                text_color: 0.114, 0.404, 0.216, 1

                MDLabel:
                    id: mic_instruction
                    text: "प्रश्न सोध्न माइक्रोफोन थिच्नुहोस्"
                    font_name: "NepaliFont"
                    halign: "center"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 0.3, 0.32, 0.3, 1
                    font_size: "15sp"

                MDLabel:
                    text: "(Tap & Speak)"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.114, 0.404, 0.216, 1
                    font_style: "Caption"
                    font_size: "13sp"
                    adaptive_height: True

        ####################################################
        ## SUGGESTIONS
        ####################################################

        MDCard:
            size_hint_y: .30
            radius: [22]
            elevation: 1
            padding: "16dp"
            md_bg_color: 1, 1, 1, 1

            MDBoxLayout:
                orientation: "vertical"
                spacing: "8dp"

                MDLabel:
                    id: suggestions_title
                    text: "उदाहरण प्रश्नहरू"
                    font_name: "NepaliFont"
                    bold: True
                    font_size: "15sp"
                    halign: "left"
                    size_hint_y: None
                    height: "22dp"
                    theme_text_color: "Custom"
                    text_color: 0.42, 0.45, 0.42, 1

                MDSeparator:
                    color: 0.9, 0.92, 0.89, 1

                ScrollView:
                    do_scroll_x: False

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "6dp"

                        MDFlatButton:
                            size_hint_x: 1
                            halign: "left"
                            on_release: root.select_suggestion(root.ids.example1)
                            MDLabel:
                                id: example1
                                font_name: "NepaliFont"
                                adaptive_height: True
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 0.29, 0.32, 0.29, 1
                                font_size: "14sp"

                        MDFlatButton:
                            size_hint_x: 1
                            halign: "left"
                            on_release: root.select_suggestion(root.ids.example2)
                            MDLabel:
                                id: example2
                                font_name: "NepaliFont"
                                adaptive_height: True
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 0.29, 0.32, 0.29, 1
                                font_size: "14sp"

                        MDFlatButton:
                            size_hint_x: 1
                            halign: "left"
                            on_release: root.select_suggestion(root.ids.example3)
                            MDLabel:
                                id: example3
                                font_name: "NepaliFont"
                                adaptive_height: True
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 0.29, 0.32, 0.29, 1
                                font_size: "14sp"

                        MDFlatButton:
                            size_hint_x: 1
                            halign: "left"
                            on_release: root.select_suggestion(root.ids.example4)
                            MDLabel:
                                id: example4
                                font_name: "NepaliFont"
                                adaptive_height: True
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 0.29, 0.32, 0.29, 1
                                font_size: "14sp"

                        MDFlatButton:
                            size_hint_x: 1
                            halign: "left"
                            on_release: root.select_suggestion(root.ids.example5)
                            MDLabel:
                                id: example5
                                font_name: "NepaliFont"
                                adaptive_height: True
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 0.29, 0.32, 0.29, 1
                                font_size: "14sp"